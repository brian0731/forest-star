# remains unavailable. Never put these values or credential files in Flutter.
APPLE_KEY_FILE=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_APP_ID=
APPLE_ROOT_CERTS=
ALLOW_APPLE_SANDBOX=false

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PUSH_AUDIENCE=https://star.singtu.hk/api/gacha/notifications/google
GOOGLE_PUSH_EMAIL=
