/game/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/health.json
  Cache-Control: no-store
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/content/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
