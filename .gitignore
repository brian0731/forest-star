# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/

# Local release signing secrets and key backups.
**/key.properties
*.jks
*.keystore
*.p12
*.key-password

# Generated preview captures and local configuration are not source assets.
/output/review/
/output/preview/
/output/audio/
/output/server/
/output/imagegen/level2-v1/
**/__pycache__/
*.pfx
*.key
*.apks
*.apk
*.aab
.env
.env.*
!.env.example
!.env.*.example
/config/admob.production.json

# Apple signing credentials and local build configuration.
*.p8
*.mobileprovision
*.provisionprofile
*.ipa
/ios/Flutter/Signing.xcconfig
